#!/usr/bin/env bash
# Reload Hyprland when the AC adapter is plugged or unplugged. The Lua config reads
# the adapter state at load (land/power.lua), so a reload is all a switch needs.
ac=/sys/class/power_supply/ACAD/online
last=$(cat "$ac")

udevadm monitor --udev --subsystem-match=power_supply | while read -r _; do
	now=$(cat "$ac")
	[ "$now" = "$last" ] && continue
	last=$now
	hyprctl reload >/dev/null
	if [ "$now" = 1 ]; then
		notify-send -a power "On AC" "Full profile: 144Hz, animations, blur"
	else
		notify-send -a power "On battery" "Saver profile: 60Hz, no animations or blur"
	fi
done
