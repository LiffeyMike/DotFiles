#!/usr/bin/env bash
# Opens the workspace 9 tools one at a time so its master layout (land/rules.lua) arranges them
# the same way every login: pavucontrol first (master, right column), then Blueman and
# NVIDIA Settings stacked top to bottom on the left. Each app waits for the previous window.
wait_for() {
	for _ in $(seq 100); do
		hyprctl clients -j | grep -q "\"class\": \"$1\"" && return
		sleep 0.1
	done
}

sleep 10 # let the Bluetooth headset finish connecting before pavucontrol lists devices
uwsm app -- pavucontrol &
wait_for org.pulseaudio.pavucontrol
uwsm app -- blueman-manager &
wait_for blueman-manager
uwsm app -- nvidia-settings &
