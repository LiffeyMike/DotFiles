/* Generated by `theme` for {{ theme.name }}: the theme picker's own style. */
* {
  bg: #{{ p.bg }};
  surface: #{{ p.surface0 }};
  fg: #{{ p.fg }};
  muted: #{{ p.subtext }};
  accent: #{{ p.accent }};
  font: "{{ look.font }} {{ look.font_size }}";
  background-color: transparent;
  text-color: @fg;
}

window {
  width: 960px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: {{ look.ui_rounding }}px;
  padding: 24px;
}

mainbox {
  children: [inputbar, listview];
  spacing: 20px;
}

inputbar {
  children: [prompt, entry];
  background-color: @surface;
  border-radius: {{ look.ui_rounding }}px;
  padding: 10px 14px;
  spacing: 12px;
}

prompt {
  text-color: @accent;
}

entry {
  placeholder: "Search themes…";
  placeholder-color: @muted;
}

listview {
  columns: 2;
  lines: 2;
  flow: horizontal;
  fixed-height: true;
  fixed-columns: true;
  spacing: 16px;
  scrollbar: false;
}

element {
  orientation: vertical;
  padding: 12px;
  spacing: 10px;
  border: 2px;
  border-color: transparent;
  border-radius: {{ look.ui_rounding }}px;
}

element selected {
  background-color: @surface;
  border-color: @accent;
}

element-icon {
  size: 260px;
}

element-text {
  horizontal-align: 0.5;
}
