/* # By knightfall01 on Github as a part of https://github.com/Knightfall01/Hyprland-config */


* {
  font-family: "JetBrainsMono Nerd Font";
  color: #{{ .palette.text }};
}

window {
  border: 3px solid #{{ .palette.blue }};
  background: #{{ .palette.base }};
  border-radius: 15px;
}

#input {
  margin: 1.5em;
  margin-bottom: 0em;
  padding: 1em;
  border: none;
  font-weight: bold;
  background: #{{ .palette.base }};
  color: #{{ .palette.text }};
  border-radius: 15px;
}

#input:focus {
  border: 1px solid #{{ .palette.blue }};
}

#inner-box {
  margin: 1.5em;
  margin-top: 0.5em;
}

#outer-box {
  margin-bottom: 0.5em;
}

#scroll {
  margin-top: 5px 0;
  display: none;
}

#text {
  margin-left: 0.5em;
  color: #{{ .palette.text }};
}

#text:selected {
  color: #{{ .palette.crust }};
}

#entry {
  margin-top: 0.5em;
  border-radius: 15px;
}

#entry:selected {
  background: linear-gradient(90deg, #{{ .palette.blue }} 0%, #{{ .palette.mauve }} 80%);
}
