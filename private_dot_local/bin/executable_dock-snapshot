#!/bin/bash
# dock-snapshot: record dock-related link/power state so the state at a fresh
# login can be compared with the state after the WD19TB Thunderbolt link drops
# and re-enumerates. Snapshots go to ~/dock-snapshots.
#
#   dock-snapshot [tag]   take one snapshot now
#   dock-snapshot watch   snapshot now, wait for a "Link Down", snapshot again
#                         ~25 s after the dock re-enumerates, and write a diff

OUT="$HOME/dock-snapshots"
mkdir -p "$OUT"

snap() {
	local tag="$1"
	local f="$OUT/$(date +%Y%m%d-%H%M%S)-$tag.txt"
	{
		echo "# $(date) uptime=$(cut -d' ' -f1 /proc/uptime)s tag=$tag"
		echo "## typec port0"
		for k in power_role data_role power_operation_mode; do
			echo "$k=$(cat /sys/class/typec/port0/$k 2>/dev/null)"
		done
		echo "## ucsi source psy"
		grep -E "ONLINE|STATUS|VOLTAGE_NOW|CURRENT_NOW" /sys/class/power_supply/ucsi-source-psy-USBC000:001/uevent 2>/dev/null
		echo "## mains/battery"
		grep -E "ONLINE|STATUS|CURRENT_NOW" /sys/class/power_supply/ACAD/uevent /sys/class/power_supply/BAT1/uevent 2>/dev/null
		echo "## thunderbolt 0-1"
		for k in authorized tx_speed rx_speed tx_lanes rx_lanes generation; do
			echo "$k=$(cat /sys/bus/thunderbolt/devices/0-1/$k 2>/dev/null)"
		done
		echo "## pci links on dock path"
		for d in 0000:00:07.0 0000:02:00.0 0000:03:02.0 0000:03:04.0 0000:04:00.0; do
			p=/sys/bus/pci/devices/$d
			[ -d "$p" ] || { echo "$d absent"; continue; }
			line="$d speed=$(cat $p/current_link_speed 2>/dev/null) width=$(cat $p/current_link_width 2>/dev/null) pm=$(cat $p/power/control)/$(cat $p/power/runtime_status)"
			for k in clkpm l0s_aspm l1_aspm l1_1_aspm l1_2_aspm l1_1_pcipm l1_2_pcipm; do
				[ -f "$p/link/$k" ] && line="$line $k=$(cat $p/link/$k)"
			done
			echo "$line"
		done
		echo "## usb devices on dock"
		for d in /sys/bus/usb/devices/[56]-*; do
			[ -f "$d/product" ] || continue
			echo "$(basename $d) '$(cut -c1-28 $d/product)' pm=$(cat $d/power/control)/$(cat $d/power/runtime_status)"
		done
		echo "## nvidia 01:00.0"
		echo "pm=$(cat /sys/bus/pci/devices/0000:01:00.0/power/control)/$(cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status)"
		echo "## drm connectors"
		for c in /sys/class/drm/card1-DP-* /sys/class/drm/card1-eDP-1; do
			[ -e "$c" ] && echo "$(basename $c) $(cat $c/status)/$(cat $c/enabled)"
		done
		echo "## hyprland monitors"
		hyprctl monitors 2>/dev/null | grep -E "^Monitor|@"
		echo "## link downs so far"
		journalctl -b -k --no-pager 2>/dev/null | grep -c "Slot(0): Link Down"
	} >"$f" 2>&1
	echo "$f"
}

case "${1:-now}" in
watch)
	before=$(snap login)
	while :; do
		# Block until the next Link Down appears in the kernel log.
		journalctl -kf -n0 -o cat 2>/dev/null | grep -m1 -q "Slot(0): Link Down"
		snap drop >/dev/null
		logger -t dock-snapshot -- "link down seen, waiting for the dock to settle"
		command -v notify-send >/dev/null && notify-send -u critical -t 30000 "Dock link dropped" "Automatic recovery in about 20 s. Please don't log out."
		# The dock often resets several times in a burst. Wait until there
		# have been no link or Thunderbolt events for 15 s before acting.
		while :; do
			sleep 15
			n=$(journalctl -k --no-pager -o cat --since "15 seconds ago" 2>/dev/null | grep -cE "Slot\(0\)|thunderbolt 0-1")
			[ "$n" -eq 0 ] && break
		done
		after=$(snap after-replug)
		diff -u "$before" "$after" >"$OUT/$(date +%Y%m%d-%H%M%S)-DIFF.txt"
		# Keep the compositor log of the affected instance for a bug report;
		# the instance directory is deleted when the session ends.
		log="/run/user/$(id -u)/hypr/$HYPRLAND_INSTANCE_SIGNATURE/hyprland.log"
		[ -f "$log" ] && cp "$log" "$OUT/$(date +%Y%m%d-%H%M%S)-hyprland.log"
		# Un-wedge the compositor (no-op if every monitor has a mode), then
		# go back to waiting for the next drop.
		"$HOME/.local/bin/dock-recover"
		before=$after
	done
	;;
*)
	snap "${1:-now}"
	;;
esac
