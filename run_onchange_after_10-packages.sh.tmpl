#!/bin/sh
# Install the packages listed in packages/. chezmoi re-runs this when a list changes:
# pacman.txt {{ include "packages/pacman.txt" | sha256sum }}
# aur.txt    {{ include "packages/aur.txt" | sha256sum }}
set -eu
cd "{{ .chezmoi.sourceDir }}/packages"

# pacman -T prints only the packages that aren't installed, so a no-op run never asks for sudo.
missing=$(pacman -T $(cat pacman.txt) || true)
if [ -n "$missing" ]; then
    sudo pacman -S --needed $missing
fi

command -v yay >/dev/null || sudo pacman -S --needed yay
missing=$(pacman -T $(cat aur.txt) || true)
if [ -n "$missing" ]; then
    yay -S --needed $missing
fi
